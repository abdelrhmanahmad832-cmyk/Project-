# انسخ هذا الملف إلى .env وعدّل القيم

# (مطلوب) رابط قاعدة بيانات PostgreSQL — من Supabase أو Neon أو أي مزود
# Supabase: Project Settings → Database → Connection string (URI)
# Neon:     Dashboard → Connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# باقي القيم اختيارية

# اسم المتجر والعملة
STORE_NAME=سوق
CURRENCY=EGP

# الشحن: رسوم ثابتة، ومجاني للطلبات فوق الحد (0 = بدون شحن مجاني)
SHIPPING_FEE=50
FREE_SHIPPING_MIN=1000

# الدفع الإلكتروني عبر Stripe (اتركه فارغاً لتعطيل الدفع بالبطاقة)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# رابط الموقع العام (يُستخدم لروابط الرجوع من صفحة الدفع)
PUBLIC_URL=

# الأمان — إن لم يُضبط يتم توليد مفتاح عشوائي وحفظه داخل قاعدة البيانات
JWT_SECRET=

# حساب المدير الأول (يُنشأ مرة واحدة فقط عند أول تشغيل)
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=admin123

# أخرى
PORT=4000
MAX_UPLOAD_MB=5
# DATABASE_SSL=true      # افتراضياً: مفعّل لقواعد البيانات الأونلاين، ومعطّل لـ localhost
# TRUST_PROXY=1
