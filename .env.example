# انسخ هذا الملف إلى .env وعدّل القيم (كلها اختيارية)

# اسم المتجر والعملة
STORE_NAME=سوق
CURRENCY=EGP

# الشحن: رسوم ثابتة، ومجاني للطلبات فوق الحد (0 = بدون شحن مجاني)
SHIPPING_FEE=50
FREE_SHIPPING_MIN=1000

# الدفع الإلكتروني عبر Stripe (اتركه فارغاً لتعطيل الدفع بالبطاقة)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# رابط الموقع العام (يُستخدم لروابط الرجوع من صفحة الدفع)
PUBLIC_URL=

# الأمان — إن لم يُضبط يتم توليد مفتاح عشوائي وحفظه بجانب قاعدة البيانات
JWT_SECRET=

# حساب المدير الأول (يُنشأ مرة واحدة فقط عند أول تشغيل)
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=admin123

# أخرى
PORT=4000
MAX_UPLOAD_MB=5
# DB_PATH=./server/store.db
# UPLOAD_DIR=./server/uploads
# TRUST_PROXY=1
